{
  "name": "@folio/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir=dist",
    "typecheck": "tsc --noEmit",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply folio-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply folio-db --remote",
    "test": "vitest run"
  },
  "dependencies": {
    "@better-auth/passkey": "^1.7.5",
    "better-auth": "^1.7.5",
    "exceljs": "^4.4.0",
    "fflate": "^0.8.3",
    "hono": "^4.7.5",
    "pdf-lib": "^1.17.1",
    "stripe": "^22.6.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250317.0",
    "@types/node": "^22.20.2",
    "typescript": "^5.8.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.20.0"
  }
}
