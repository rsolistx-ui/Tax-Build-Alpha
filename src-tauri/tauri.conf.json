{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Folio Beta",
  "version": "0.1.0",
  "identifier": "com.foliobeta.desktop",
  "build": {
    "frontendDist": "https://folio-api.rsolistx.workers.dev"
  },
  "app": {
    "windows": [
      {
        "title": "Folio Beta",
        "url": "https://folio-api.rsolistx.workers.dev",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": false
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
