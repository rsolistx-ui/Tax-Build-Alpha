{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Truepost",
  "version": "0.1.0",
  "identifier": "com.truepost.desktop",
  "build": {
    "frontendDist": "https://folio-api.rsolistx.workers.dev"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    },
    "withGlobalTauri": false
  },
  "bundle": {
    "active": true,
    "publisher": "Truepost",
    "category": "Business",
    "shortDescription": "Verified double-entry bookkeeping and practice OS",
    "longDescription": "Truepost — verified double-entry bookkeeping and practice OS for modern firms. All data lives server-side; the EXE is a hardened WebView wrapper (Tauri/Rust, no Electron).",
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
