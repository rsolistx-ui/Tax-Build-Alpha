{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Folio Beta",
  "version": "0.1.0",
  "identifier": "com.foliobeta.desktop",
  "build": {
    "frontendDist": "https://folio-api.rsolistx.workers.dev"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    },
    "withGlobalTauri": false
  },
  "bundle": {
    "active": true,
    "publisher": "Tax Build Alpha",
    "category": "Business",
    "shortDescription": "Evidence-first bookkeeping and tax workspace",
    "longDescription": "Folio Beta — evidence-first bookkeeping and tax workspace for firms. All data lives server-side; the EXE is a hardened WebView wrapper (Tauri/Rust, no Electron).",
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
